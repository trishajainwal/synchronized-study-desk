STUDYDESK_APP_NAME=Synchronized Study Desk API
STUDYDESK_ENVIRONMENT=development
STUDYDESK_LOG_LEVEL=INFO
STUDYDESK_DATA_DIR=./data
STUDYDESK_DATABASE_URL=sqlite:///./data/studydesk.db
STUDYDESK_UPLOAD_DIR=./data/uploads
STUDYDESK_MAX_UPLOAD_MB=25
STUDYDESK_OLLAMA_BASE_URL=http://127.0.0.1:11434
STUDYDESK_OLLAMA_MODEL=qwen3.5:4b
STUDYDESK_OLLAMA_TIMEOUT_SECONDS=10
STUDYDESK_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
